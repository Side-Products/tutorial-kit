# Copy beside your tutorials.config.mjs as .env. Never commit that file.
# Only script/plan (and opted-in self-healing) need the LLM key.
OPENAI_API_KEY=
TUTORIAL_LLM_MODEL=
# Optional OpenAI-compatible provider; receives your key and prompt data.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Only voice synthesis needs these values. Choose a voice available to your account.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional form login for a dedicated demo account.
TUTORIAL_EMAIL=
TUTORIAL_PASSWORD=

# Optional resource limits and system FFmpeg path.
# RENDER_CONCURRENCY=2
# TUTORIAL_FFMPEG_PATH=/absolute/path/to/ffmpeg
# ELEVENLABS_MAX_CONCURRENCY=4
# ELEVENLABS_MAX_RETRIES=4
