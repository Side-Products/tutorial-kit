{
	"name": "tutorials-kit",
	"version": "0.1.4",
	"description": "Turn browser workflows into narrated tutorial videos, screenshots, and structured guides.",
	"type": "module",
	"bin": {
		"tutorials-kit": "bin/tutorial-kit.js",
		"tutorial-kit": "bin/tutorial-kit.js",
		"tkit": "bin/tutorial-kit.js"
	},
	"files": [
		"bin",
		"src",
		"templates",
		"README.md",
		"CHANGELOG.md",
		"LICENSE",
		"SECURITY.md",
		"THIRD_PARTY_NOTICES.md",
		"apple-touch-icon.png",
		"docs"
	],
	"engines": {
		"node": ">=22"
	},
	"license": "MIT",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"dependencies": {
		"@remotion/bundler": "4.0.523",
		"@remotion/renderer": "4.0.523",
		"playwright": "1.63.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"remotion": "4.0.523",
		"sharp": "^0.35.4"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Side-Products/tutorials-kit.git"
	},
	"homepage": "https://github.com/Side-Products/tutorials-kit#readme",
	"bugs": {
		"url": "https://github.com/Side-Products/tutorials-kit/issues"
	},
	"keywords": [
		"tutorial",
		"playwright",
		"remotion",
		"screen-recording",
		"documentation",
		"video"
	],
	"scripts": {
		"test": "node --test test/*.test.mjs",
		"test:integration": "node --test test/integration/*.test.mjs",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "npm run format:check && npm test",
		"demo": "node examples/basic/server.mjs"
	},
	"devDependencies": {
		"prettier": "3.9.6"
	}
}
